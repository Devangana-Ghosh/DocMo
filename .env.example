VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: doctor availability provider endpoint (Google Calendar / Microsoft Graph proxy)
# POST body: { doctorId: string, date: string }
# Response: { slots: string[] }
VITE_AVAILABILITY_API_URL=

# Optional: video meeting creation endpoint (Google Meet / other provider proxy)
# POST body: { doctorName, patientName, date, time }
# Response: { meetingLink: string }
VITE_VIDEO_LINKS_API_URL=

# Fallback video meeting base URL when no provider endpoint is configured
# Example: https://meet.google.com/new
VITE_VIDEO_MEETING_BASE_URL=https://meet.google.com/new

# Simplest Google Meet path: paste one reusable Meet link here
# Example: https://meet.google.com/abc-defg-hij
VITE_FIXED_MEET_LINK=

# Optional: consultation alert webhook (email/SMS notifier)
# POST body includes doctor/patient names, emails, date/time, type, meeting link
VITE_CONSULTATION_ALERTS_WEBHOOK_URL=

# Optional: role-aware AI assistant endpoint (Supabase Edge Function)
# If omitted, app defaults to ${VITE_SUPABASE_URL}/functions/v1/ai-assistant
VITE_AI_ASSISTANT_API_URL=

# Optional: enable Puter browser LLM for non-medical app-help chat
# true = use Puter.js for general chat; medical/drug queries still use backend assistant
VITE_USE_PUTER_LLM=true
VITE_PUTER_MODEL=gpt-5.4
